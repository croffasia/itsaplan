{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*.ts",
    "#mcp/*": "./src/mcp/*.ts",
    "#modules/*": "./src/modules/*.ts",
    "#tests/*": "./src/__tests__/*.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --env-file=../../.env.test",
    "test:coverage": "bun test --env-file=../../.env.test --coverage; bun scripts/coverage-report.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.41",
    "@aws-sdk/client-s3": "^3.1109.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@firecrawl/pdf-inspector": "^1.17.0",
    "@mastra/core": "^1.58.0",
    "@mastra/memory": "^1.26.1",
    "@mastra/pg": "^1.20.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@repo/agent-tools": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/crypto": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/mailer": "workspace:*",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@repo/eslint-config": "workspace:*",
    "@types/bun": "latest",
    "eslint": "^9.39.0",
    "typescript": "^6.0.3"
  }
}
