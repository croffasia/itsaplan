# Next.js reads .env only from its own folder (apps/web/.env). Copy: cp .env.example .env
# These are read by the server at startup and handed to the browser on every render,
# so a deployment sets them on the container instead (see the root .env.example).

# Public URL of the api the browser reaches (same value as API_URL in the root .env):
API_URL=http://localhost:3000

# Optional: serve the api on the web app's own origin. The web server passes the
# browser's api calls through to this address, so the page works, signed in, on any
# host it is opened on (a dev proxy such as *.orca.localhost, a LAN name). API_URL is
# then not handed to the browser. Set the root API_URL to the web app's URL and list
# the extra hosts in the root APP_URL (wildcards allowed, e.g. http://*.orca.localhost:60418).
# API_PROXY_TARGET=http://localhost:3000

# Legal document URLs shown on the logged-out screens. Point them at this instance's
# own privacy policy and terms; Google OAuth sign-in requires the privacy policy to
# be reachable. Leave empty to hide the legal notice.
PRIVACY_URL=
TERMS_URL=
