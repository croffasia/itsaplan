# Production .env for a VPS. Copy to the repository root as .env and fill in.
#   cp deploy/vps/env.vps.example .env
# Generate every secret with: openssl rand -base64 32

# ── Domains (both must point at this server) ──
APP_DOMAIN=plan.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# Public origins, derived from the domains above.
APP_URL=https://plan.example.com
API_URL=https://api.example.com

# ── Database ──
POSTGRES_USER=itsaplan
POSTGRES_PASSWORD=
POSTGRES_DB=itsaplan

# ── Secrets ──
BETTER_AUTH_SECRET=
APP_ENCRYPTION_KEY=

# ── File storage (RustFS, inside the stack; port 9000 is not published) ──
S3_ACCESS_KEY_ID=itsaplan-storage
S3_SECRET_ACCESS_KEY=
S3_BUCKET=planner-attachments
S3_REGION=us-east-1

# Builds this checkout instead of pulling the published images.
# VERSION=latest
