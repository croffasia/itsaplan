{
  "name": "itsaplan",
  "version": "1.9.0",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@repo/eslint-config": "workspace:*",
    "@types/bun": "^1.4.3",
    "eslint": "^9.39.0",
    "lefthook": "^2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.3",
  "private": true,
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "test": "bun test scripts/ && turbo run test --concurrency=1",
    "test:coverage": "cd apps/api && bun run test:coverage",
    "db:generate": "bun --filter='@repo/db' run db:generate",
    "db:migrate": "bun --filter='@repo/db' run db:migrate",
    "db:migrate:test": "SKIP_PRE_MIGRATION_BACKUP=1 bun --env-file=.env.test packages/db/src/migrate.ts",
    "db:studio": "bun --filter='@repo/db' run db:studio",
    "auth:generate": "bun --filter='@repo/auth' run auth:generate",
    "prepare": "lefthook install || true"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@scalar/types": "0.16.2",
    "@scalar/themes": "0.16.2",
    "body-parser": "^2.4.0"
  }
}
